# Copie para backend/.env e defina senhas locais antes de iniciar o Compose.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=etp_db
DB_USER=etp_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Porta HTTP do backend no host. O container continua ouvindo em 8080.
ETP_BACKEND_PORT=8080

# Gere uma chave local com: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Contas locais são criadas somente com perfil dev E ETP_DEMO_ENABLED=true.
SPRING_PROFILES_ACTIVE=dev
ETP_DEMO_ENABLED=false
# Popula os oito colaboradores ilustrativos; exige ETP_DEMO_ENABLED=true.
ETP_DEMO_COMPANY_DATA_ENABLED=false
ETP_DEMO_COLABORADOR_EMAIL=etp@gmail.com
ETP_DEMO_EMPRESA_EMAIL=rhetp@gmail.com
ETP_DEMO_PASSWORD=
